<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>메이플 바</Product>
    <AssemblyTitle>메이플 바</AssemblyTitle>
    <Version>1.2.13</Version>
    <!-- WFO1000: 디자이너 저장 설정 검사. 이 앱은 디자이너 없이 코드로만 화면을 만들어 해당 없음 -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>

  <!-- WebView2 패키지가 넣는 WPF용 dll은 이 앱(WinForms)에 필요 없고 .NET 10에서 WindowsBase 충돌 경고를 내서 뺀다 -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <!-- bootstrap 폴더는 따로 빌드하는 고정 설치기(MapleBar-Setup.exe)라 이 앱에 넣지 않는다 -->
  <ItemGroup>
    <Compile Remove="bootstrap\**" />
    <EmbeddedResource Remove="bootstrap\**" />
    <None Remove="bootstrap\**" />
  </ItemGroup>

  <!-- 프리텐다드 글꼴 (SIL OFL 1.1): 실행 파일 옆 Fonts 폴더로 복사 -->
  <ItemGroup>
    <None Include="Fonts\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>